# Вариант студента: эти значения читает автоматическая проверка.
# Заполните согласно своему варианту и закоммитьте.

# Символы алфавита через запятую, БЕЗ пробелов. Порядок задаёт значения цифр:
# первый символ = 0 (аддитивная единица), второй = 1, последний = base-1.
ALPHABET=a,b,d,f,i,k,g,j,h,e,c

# Границы 8-разрядного диапазона:
MINIMUM=-a
MAXIMUM=a
